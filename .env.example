# Production variables, set in Easypanel (never commit real values).
API_DOMAIN=f1-api.imanzanastore.com.ar
APP_DOMAIN=f1.imanzanastore.com.ar
FRONTEND_URL=https://f1.imanzanastore.com.ar
ALLOWED_ORIGINS=https://f1.imanzanastore.com.ar
POSTGRES_PASSWORD=            # openssl rand -hex 24
INTERNAL_LOG_KEY=             # openssl rand -hex 32; also goes in the logs MCP config
FIREBASE_PROJECT_ID=          # from P2 on
FIREBASE_CREDENTIALS_B64=     # base64 of the service-account JSON, from P2 on
# Web app (public by design, inlined in the JS bundle)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Race engineer (optional: without a key it runs on rules, with no AI)
ANTHROPIC_API_KEY=
ENGINEER_TIER=standard        # standard | pro
